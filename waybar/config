{
	"layer": "top",
	"modules-left": ["sway/workspaces", "custom/mediaplayer", "custom/cava-internal", "battery"],
	"modules-center": ["clock"],
	"modules-right": ["network", "pulseaudio", "temperature", "cpu", "memory", "custom/power"],

	"custom/music": {
		"exec": "playerctl metadata --format '{{ artist }} - {{ title }}'",
		"interval": 1,
		"return-type": "json",
		"format": "{output}",
		"tooltip": false
	},

	"battery": {
        "interval": 15,
        "states": {
            // "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format-charging": "CH:{capacity}%",
        "format": "{icon}  {capacity}%",
        "format-icons": ["", "", "", "", ""],
        "tooltip": true
    },
	
	"custom/mediaplayer": {
        "exec": "~/.config/waybar/scripts/mediaplayer.sh",
		"on-click": "playerctl play-pause",
        "interval": 3,
        "format": "{}",
        "tooltip": false
    },

	"custom/power": {
		"format": "󰤆",
		"on-click": "~/.config/rofi/powermenu/type-4/powermenu.sh",
		"tooltip": false
	},

	"pulseaudio": {
		"tooltip": false,
		"scroll-step": 5,
		"format": "{icon} {volume}%",
		"format-icons": {
			"default": ["󰕿", "󰖀", "󰕾"]
		},
		"on-click": "foot -e ~/pwctl/src/pwctl.py"
	},
	"network": {
		"tooltip": false,
		"format-wifi": " ",
		"format-ethernet": "󰈀 {ifname}"
	},
	"cpu": {
		"interval": 3,
		"tooltip": false,
		"format": " {avg_frequency}GHz",
		"on-click": "foot -e btop"	
	},
	"memory": {
		"tooltip": false,
		"format": " {}%"
	},
}
